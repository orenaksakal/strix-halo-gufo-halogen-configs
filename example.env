# Copy to .env and replace these paths with your model directories.
MODELS_DIR=/srv/models/Qwen3.8-Flash-Next-GGUF
HALOGEN_SUPPORT_DIR=/srv/models/halogen-flash-support
API_PORT=18080

# Numeric IDs from the HOST, not group names inside the containers.
# id -u; id -g; stat -c %g /dev/kfd; stat -c %g /dev/dri/renderD128
HOST_UID=1000
HOST_GID=1000
# Both GPU devices share GID 990 on the tested host. If yours have different
# groups, add the other numeric GID to group_add in compose.yaml.
GPU_GID=990
